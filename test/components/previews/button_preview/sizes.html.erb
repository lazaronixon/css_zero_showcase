<div class="flex items-center flex-wrap gap">
  <%= button_tag "Extra Small", type: "button", class: "btn btn--xs" %>
  <%= button_tag type: "button", class: "btn btn--icon-xs" do %>
    <span class="icon icon--arrow-up-right" aria-hidden="true"></span>
    <span class="sr-only">Submit</span>
  <% end %>
  <%= button_tag "Small", type: "button", class: "btn btn--sm" %>
  <%= button_tag type: "button", class: "btn btn--icon-sm" do %>
    <span class="icon icon--arrow-up-right" aria-hidden="true"></span>
    <span class="sr-only">Submit</span>
  <% end %>
  <%= button_tag "Default", type: "button", class: "btn" %>
  <%= button_tag type: "button", class: "btn btn--icon" do %>
    <span class="icon icon--arrow-up-right" aria-hidden="true"></span>
    <span class="sr-only">Submit</span>
  <% end %>
  <%= button_tag "Large", type: "button", class: "btn btn--lg" %>
  <%= button_tag type: "button", class: "btn btn--icon-lg" do %>
    <span class="icon icon--arrow-up-right" aria-hidden="true"></span>
    <span class="sr-only">Submit</span>
  <% end %>
</div>
