<input-otp appearance="seamless">
  <input-otp-group>
    <input-otp-slot></input-otp-slot>
    <input-otp-slot></input-otp-slot>
    <input-otp-slot></input-otp-slot>
  </input-otp-group>

  <input-otp-separator role="separator">
    <span class="icon icon--minus" aria-hidden="true"></span>
  </input-otp-separator>

  <input-otp-group>
    <input-otp-slot></input-otp-slot>
    <input-otp-slot></input-otp-slot>
    <input-otp-slot></input-otp-slot>
  </input-otp-group>

  <%= text_field_tag :code %>
</input-otp>
