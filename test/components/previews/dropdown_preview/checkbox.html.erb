<button type="button" class="btn" popovertarget="dropdown" aria-haspopup="true">
  Open
</button>

<div popover id="dropdown" class="popover popover--block-end-start" style="--popover-size: 10rem;" role="menu" aria-label="Menu">
  <div class="menu" data-controller="menu" data-action="keydown->menu#navigate">
    <div class="menu__group" role="group" aria-labelledby="appearance">
      <div class="menu__header" id="appearance">Appearance</div>
      <div class="btn menu__item">
        <%= label_tag :status_bar, "Status Bar", class: "flex-item-grow text-sm" %>
        <%= check_box_tag :status_bar, "1", true, class: "input", data: { menu_target: "item" }, role: "menuitemcheckbox" %>
      </div>
      <div class="btn menu__item" aria-disabled="true">
        <%= label_tag :activity_bar, "Activity Bar", class: "flex-item-grow text-sm" %>
        <%= check_box_tag :activity_bar, "1", false, class: "input", disabled: true, role: "menuitemcheckbox" %>
      </div>
      <div class="btn menu__item">
        <%= label_tag :panel, "Panel", class: "flex-item-grow text-sm" %>
        <%= check_box_tag :panel, "1", false, class: "input", data: { menu_target: "item" }, role: "menuitemcheckbox" %>
      </div>
    </div>
  </div>
</div>
