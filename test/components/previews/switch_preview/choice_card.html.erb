<div class="flex flex-col gap" style="max-inline-size: 24rem; --row-gap: 1.25rem">
  <label class="list-row list-row--check flex items-start gap">
    <div class="flex flex-1 flex-col">
      <span class="text-sm font-medium mbe-1">Share across devices</span>
      <p class="text-sm text-subtle">Focus is shared across devices, and turns off when you leave the app.</p>
    </div>
    <%= check_box_tag :share_devices, class: "switch", role: "switch" %>
  </label>

  <label class="list-row list-row--check flex items-start gap">
    <div class="flex flex-1 flex-col">
      <span class="text-sm font-medium mbe-1">Enable notifications</span>
      <p class="text-sm text-subtle">Receive notifications when focus mode is enabled or disabled.</p>
    </div>
    <%= check_box_tag :notifications, checked: true, class: "switch", role: "switch" %>
  </label>
</div>
