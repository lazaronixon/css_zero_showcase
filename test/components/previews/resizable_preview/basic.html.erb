<resizable-group class="rounded-lg border" style="block-size: 450px;">
  <resizable-panel default-size="50">
    <div class="flex items-center justify-center b-full p-6">
      <span class="font-semibold">One</span>
    </div>
  </resizable-panel>

  <resizable-separator></resizable-separator>

  <resizable-panel default-size="50">
    <resizable-group orientation="vertical">
      <resizable-panel default-size="25">
        <div class="flex items-center justify-center b-full p-6">
          <span class="font-semibold">Two</span>
        </div>
      </resizable-panel>

      <resizable-separator></resizable-separator>

      <resizable-panel default-size="75">
        <div class="flex items-center justify-center b-full p-6">
          <span class="font-semibold">Three</span>
        </div>
      </resizable-panel>
    </resizable-group>
  </resizable-panel>
</resizable-group>
