<div class="flex gap">
  <button type="button" class="btn" popovertarget="popover_start">Start</button>
  <div popover id="popover_start" class="popover popover--block-end-start text-sm p-3" role="dialog" style="--popover-size: 10rem">
    Aligned to start
  </div>

  <button type="button" class="btn" popovertarget="popover_center">Center</button>
  <div popover id="popover_center" class="popover popover--block-end-center text-sm p-3" role="dialog" style="--popover-size: 10rem">
    Aligned to center
  </div>

  <button type="button" class="btn" popovertarget="popover_end">End</button>
  <div popover id="popover_end" class="popover popover--block-end-end text-sm p-3" role="dialog" style="--popover-size: 10rem">
    Aligned to end
  </div>
</div>
