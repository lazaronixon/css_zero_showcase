<button type="button" class="btn" commandfor="command_dialog" command="show-modal">Open Menu</button>

<dialog id="command_dialog" class="dialog dialog--cmdk" style="--dialog-size: 24rem;" data-controller="dialog" data-action="click->dialog#closeOnClickOutside">
  <cmdk-root label="Command Menu" data-controller="command" data-action="cmdk:select->command#visit">
    <label class="input input--actor flex items-center gap mbe-1">
      <span class="icon icon--search" aria-hidden="true"></span>
      <%= text_field_tag "search", nil, autocomplete: "off", autofocus: true, placeholder: "Type a command or search..." %>
    </label>
    <cmdk-list>
      <cmdk-empty>No results found.</cmdk-empty>
      <cmdk-group heading="Suggestions">
        <cmdk-item value="Calendar" data-href="#">
          <span class="icon icon--calendar" aria-hidden="true"></span>
          <span>Calendar</span>
        </cmdk-item>
        <cmdk-item value="Search Emoji" data-href="#">
          <span class="icon icon--smile" aria-hidden="true"></span>
          <span>Search Emoji</span>
        </cmdk-item>
        <cmdk-item value="Calculator" data-href="#">
          <span class="icon icon--calculator" aria-hidden="true"></span>
          <span>Calculator</span>
        </cmdk-item>
      </cmdk-group>
      <cmdk-separator></cmdk-separator>
      <cmdk-group heading="Settings">
        <cmdk-item value="Profile" data-href="#">
          <span class="icon icon--user" aria-hidden="true"></span>
          <span>Profile</span>
          <kbd class="mis-auto text-xs text-subtle">⌘P</kbd>
        </cmdk-item>
        <cmdk-item value="Billing" data-href="#">
          <span class="icon icon--credit-card" aria-hidden="true"></span>
          <span>Billing</span>
          <kbd class="mis-auto text-xs text-subtle">⌘B</kbd>
        </cmdk-item>
        <cmdk-item value="Settings" data-href="#">
          <span class="icon icon--settings" aria-hidden="true"></span>
          <span>Settings</span>
          <kbd class="mis-auto text-xs text-subtle">⌘S</kbd>
        </cmdk-item>
      </cmdk-group>
    </cmdk-list>
  </cmdk-root>
</dialog>
