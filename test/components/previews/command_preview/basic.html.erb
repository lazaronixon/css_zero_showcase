<button type="button" class="btn" commandfor="command_dialog" command="show-modal">Open Menu</button>

<dialog id="command_dialog" class="dialog overflow-hidden" style="--dialog-size: 24rem;" data-controller="dialog" data-action="click->dialog#closeOnClickOutside">
  <cmdk-root label="Command Menu" data-controller="command" data-action="cmdk:select->command#visit">
    <label class="input input--actor flex items-center gap mbe-1">
      <span class="icon icon--search" aria-hidden="true"></span>
      <%= text_field_tag "search", nil, autocomplete: "off", autofocus: true, placeholder: "Type a command or search..." %>
    </label>
    <cmdk-list>
      <cmdk-empty>No results found.</cmdk-empty>
      <cmdk-group heading="Suggestions">
        <cmdk-item data-href="#">Calendar</cmdk-item>
        <cmdk-item data-href="#">Search Emoji</cmdk-item>
        <cmdk-item data-href="#">Calculator</cmdk-item>
      </cmdk-group>
    </cmdk-list>
  </cmdk-root>
</dialog>
