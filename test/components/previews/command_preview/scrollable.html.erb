<% items = [
     [ "icon--calendar",    "Calendar",     "⌘C" ],
     [ "icon--smile",       "Search Emoji", "⌘E" ],
     [ "icon--calculator",  "Calculator",   "⌘K" ],
     [ "icon--user",        "Profile",      "⌘P" ],
     [ "icon--credit-card", "Billing",      "⌘B" ],
     [ "icon--settings",    "Settings",     "⌘S" ]
   ] %>

<button type="button" class="btn" commandfor="command_dialog" command="show-modal">Open Menu</button>

<dialog id="command_dialog" class="dialog" style="--dialog-size: 24rem;" data-controller="dialog" data-action="click->dialog#closeOnClickOutside">
  <cmdk-root label="Command Menu" data-controller="command" data-action="cmdk:select->command#visit">
    <label class="input input--actor flex items-center gap mbe-1">
      <span class="icon icon--search" aria-hidden="true"></span>
      <%= text_field_tag "search", nil, autocomplete: "off", autofocus: true, placeholder: "Type a command or search..." %>
    </label>
    <cmdk-list>
      <cmdk-empty>No results found.</cmdk-empty>
      <% %w[ Suggestions Tools Account More ].each do |heading| %>
        <%= content_tag "cmdk-group", heading: heading do %>
          <% items.each do |icon, label, shortcut| %>
            <%= content_tag "cmdk-item", value: "#{label} #{heading}", data: { href: "#" } do %>
              <%= tag.span class: "icon #{icon}", aria: { hidden: true } %>
              <%= tag.span label %>
              <%= tag.kbd shortcut, class: "mis-auto text-xs text-subtle" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </cmdk-list>
  </cmdk-root>
</dialog>
