<button type="button" class="btn btn--icon hide@md" commandfor="sheet_sidebar" command="show-modal">
  <span class="icon icon--panel-left" style="--icon-size: 1.25rem" aria-hidden="true"></span>
  <span class="sr-only">Open menu</span>
</button>

<dialog id="sheet_sidebar" class="sheet sheet--left" style="--sheet-size: 288px;" data-controller="dialog" data-action="click->dialog#closeOnClickOutside">
  <div class="sheet__content p-2">
    <%= render "sidebar_menu" %>
  </div>
</dialog>
